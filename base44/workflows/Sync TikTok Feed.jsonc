{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_tiktok_feed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_tiktok_feed": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncTikTokFeed",
            "args": {
              "source": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh TikTok feed",
            "description": "Sync latest posts"
          }
        }
      }
    ]
  },
  "name": "Sync TikTok Feed",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Refreshes the official Upper Vibe TikTok feed automatically."
}