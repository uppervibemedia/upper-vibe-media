{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "isPlus": {
      "type": "boolean",
      "default": false,
      "description": "True if user has an active Plus subscription"
    },
    "isPremium": {
      "type": "boolean",
      "default": false,
      "description": "Legacy compatibility field - same as isPlus"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "premium"
      ],
      "default": "free",
      "description": "Membership tier"
    },
    "plan": {
      "type": "string",
      "description": "Active plan name e.g. plus"
    },
    "planName": {
      "type": "string",
      "description": "Display name e.g. Upper Vibe Plus"
    },
    "billingCycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "description": "Billing interval"
    },
    "subscriptionStatus": {
      "type": "string",
      "description": "Stripe subscription status e.g. active, inactive, cancelled"
    },
    "subscription_status": {
      "type": "string",
      "description": "Snake-case alias of subscriptionStatus for legacy checks"
    },
    "stripeCustomerId": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripeSubscriptionId": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "stripePriceId": {
      "type": "string",
      "description": "Stripe price ID for the active plan"
    },
    "stripeProductId": {
      "type": "string",
      "description": "Stripe product ID"
    },
    "plusStartedAt": {
      "type": "string",
      "description": "ISO datetime when Plus was first activated"
    },
    "subscriptionCurrentPeriodEnd": {
      "type": "string",
      "description": "ISO datetime when current billing period ends"
    },
    "vibe_name": {
      "type": "string",
      "description": "Display name in the Vibe Room"
    },
    "vibe_avatar_url": {
      "type": "string",
      "description": "Custom avatar URL"
    },
    "vibe_room_age_confirmed": {
      "type": "boolean",
      "default": false
    },
    "world_username": {
      "type": "string",
      "description": "Public display username in Upper Vibe City"
    },
    "world_username_lower": {
      "type": "string",
      "description": "Lowercase username for uniqueness checks"
    },
    "avatar_type": {
      "type": "string",
      "enum": [
        "masculine",
        "feminine",
        "nonbinary",
        "neutral"
      ],
      "description": "Avatar body type for Upper Vibe City"
    },
    "avatar_gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "default": "male",
      "description": "GLB model gender for avatar: male=Soldier.glb, female=Michelle.glb"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "light",
        "medium-light",
        "medium",
        "medium-dark",
        "dark",
        "deep"
      ],
      "description": "Skin tone for avatar"
    },
    "avatar_style": {
      "type": "string",
      "enum": [
        "streetwear",
        "cosmic",
        "neon",
        "shadow",
        "golden",
        "crimson"
      ],
      "default": "streetwear",
      "description": "Avatar visual style preset"
    },
    "avatar_outfit_color": {
      "type": "string",
      "description": "Outfit color key e.g. electric-blue"
    },
    "avatar_suit_color": {
      "type": "string",
      "description": "Hex color for the avatar suit e.g. #4a5c3a"
    },
    "uvc_rules_accepted": {
      "type": "boolean",
      "default": false
    },
    "uvc_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "uvc_chat_age_confirmed": {
      "type": "boolean",
      "default": false
    },
    "uvc_accepted_date": {
      "type": "string"
    },
    "uvc_agreement_version": {
      "type": "string"
    },
    "outfit_id": {
      "type": "string"
    },
    "hair_id": {
      "type": "string"
    },
    "accessory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shoe_id": {
      "type": "string"
    },
    "aura_id": {
      "type": "string"
    },
    "emote_pack_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owned_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rpm_avatar_url": {
      "type": "string",
      "description": "Ready Player Me avatar GLB URL"
    }
  }
}