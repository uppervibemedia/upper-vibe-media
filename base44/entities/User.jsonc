{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "isPlus": {
      "type": "boolean",
      "default": false,
      "description": "True if user has an active Plus subscription"
    },
    "isPremium": {
      "type": "boolean",
      "default": false,
      "description": "Legacy compatibility field - same as isPlus"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "premium"
      ],
      "default": "free",
      "description": "Membership tier"
    },
    "plan": {
      "type": "string",
      "description": "Active plan name e.g. plus"
    },
    "planName": {
      "type": "string",
      "description": "Display name e.g. Upper Vibe Plus"
    },
    "billingCycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "description": "Billing interval"
    },
    "subscriptionStatus": {
      "type": "string",
      "description": "Stripe subscription status e.g. active, inactive, cancelled"
    },
    "subscription_status": {
      "type": "string",
      "description": "Snake-case alias of subscriptionStatus for legacy checks"
    },
    "stripeCustomerId": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripeSubscriptionId": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "stripePriceId": {
      "type": "string",
      "description": "Stripe price ID for the active plan"
    },
    "stripeProductId": {
      "type": "string",
      "description": "Stripe product ID"
    },
    "plusStartedAt": {
      "type": "string",
      "description": "ISO datetime when Plus was first activated"
    },
    "subscriptionCurrentPeriodEnd": {
      "type": "string",
      "description": "ISO datetime when current billing period ends"
    },
    "vibe_name": {
      "type": "string",
      "description": "Display name in the Vibe Room"
    },
    "vibe_avatar_url": {
      "type": "string",
      "description": "Custom avatar URL"
    },
    "vibe_room_age_confirmed": {
      "type": "boolean",
      "default": false
    },
    "world_username": {
      "type": "string",
      "description": "Public display username in Upper Vibe City"
    },
    "world_username_lower": {
      "type": "string",
      "description": "Lowercase username for uniqueness checks"
    },
    "avatar_type": {
      "type": "string",
      "enum": [
        "masculine",
        "feminine",
        "nonbinary",
        "neutral"
      ],
      "description": "Avatar body type for Upper Vibe City (no default \u2014 user must pick)"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "light",
        "medium-light",
        "medium",
        "medium-dark",
        "dark",
        "deep"
      ],
      "description": "Skin tone for avatar in Upper Vibe City (no default \u2014 user must pick)"
    },
    "avatar_style": {
      "type": "string",
      "enum": [
        "streetwear",
        "cosmic"
      ],
      "default": "streetwear",
      "description": "Avatar outfit style: streetwear = modern human look, cosmic = futuristic armor"
    },
    "uvc_rules_accepted": {
      "type": "boolean",
      "default": false,
      "description": "User accepted Upper Vibe City community rules"
    },
    "uvc_agreement_accepted": {
      "type": "boolean",
      "default": false,
      "description": "User accepted Upper Vibe City user agreement"
    },
    "uvc_chat_age_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "User confirmed they are 18+ for chat access"
    },
    "uvc_accepted_date": {
      "type": "string",
      "description": "ISO datetime when rules/agreement were accepted"
    },
    "uvc_agreement_version": {
      "type": "string",
      "description": "Version identifier of the accepted agreement"
    },
    "outfit_id": {
      "type": "string",
      "description": "Future: equipped outfit ID from Vibe Shop"
    },
    "hair_id": {
      "type": "string",
      "description": "Future: equipped hairstyle ID from Vibe Shop"
    },
    "accessory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Future: equipped accessory IDs"
    },
    "shoe_id": {
      "type": "string",
      "description": "Future: equipped shoe ID from Vibe Shop"
    },
    "aura_id": {
      "type": "string",
      "description": "Future: equipped aura/effect ID from Vibe Shop"
    },
    "emote_pack_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Future: owned emote pack IDs"
    },
    "owned_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Future: all owned item IDs from Vibe Shop"
    }
  }
}