{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "premium"
      ],
      "default": "user"
    },
    "vibe_room_age_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "User has confirmed they are 18+ to access Vibe Room"
    },
    "vibe_name": {
      "type": "string",
      "description": "Public display name in the Vibe Room (3-20 chars, letters/numbers/underscores)"
    }
  }
}