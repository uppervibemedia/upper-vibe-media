{
  "name": "SongDislike",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who disliked"
    },
    "track_id": {
      "type": "string",
      "description": "ID of the disliked track"
    },
    "cached_title": {
      "type": "string",
      "description": "Cached title for reference"
    }
  },
  "required": [
    "user_email",
    "track_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}