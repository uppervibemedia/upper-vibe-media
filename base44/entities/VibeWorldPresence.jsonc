{
  "name": "VibeWorldPresence",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Authenticated user ID"
    },
    "username": {
      "type": "string",
      "description": "Display name shown to other users"
    },
    "avatar_type": {
      "type": "string",
      "enum": [
        "masculine",
        "feminine",
        "nonbinary",
        "neutral",
        "default",
        "cyber",
        "cosmic",
        "neon"
      ],
      "default": "neutral"
    },
    "avatar_type_key": {
      "type": "string",
      "description": "Exact avatar key used in CityCanvas e.g. test-mixamo-female, test-mixamo-male"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "light",
        "medium-light",
        "medium",
        "medium-dark",
        "dark",
        "deep"
      ],
      "default": "medium"
    },
    "avatar_style": {
      "type": "string",
      "enum": [
        "streetwear",
        "cosmic"
      ],
      "default": "streetwear",
      "description": "Outfit style for the avatar"
    },
    "avatar_outfit_color": {
      "type": "string",
      "description": "Outfit color key e.g. electric-blue, neon-purple"
    },
    "current_zone": {
      "type": "string",
      "description": "Current zone in Vibe World e.g. plaza, lounge, stage"
    },
    "pos_x": {
      "type": "number",
      "default": 0,
      "description": "World X position"
    },
    "pos_z": {
      "type": "number",
      "default": 0,
      "description": "World Z position"
    },
    "rotation": {
      "type": "number",
      "default": 0,
      "description": "World Y rotation in radians"
    },
    "animation_state": {
      "type": "string",
      "enum": [
        "idle",
        "walking",
        "running",
        "dancing"
      ],
      "default": "idle",
      "description": "Current animation state of the avatar"
    },
    "equipped_aura": {
      "type": "string",
      "description": "Item id of equipped aura/glow, empty if none"
    },
    "equipped_aura_color": {
      "type": "string",
      "description": "Hex color of equipped aura, empty if none"
    },
    "equipped_hoverboard": {
      "type": "string",
      "description": "Item id of equipped hoverboard, empty if none"
    },
    "personal_hoverboard_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is currently riding a personal hoverboard"
    },
    "is_online": {
      "type": "boolean",
      "default": true
    },
    "last_heartbeat": {
      "type": "string",
      "description": "ISO timestamp of last heartbeat"
    },
    "joined_at": {
      "type": "string",
      "description": "ISO timestamp when user entered Vibe World"
    },
    "lifetime_orbs": {
      "type": "number",
      "default": 0,
      "description": "Lifetime Vibe Orbs collected \u2014 used for leaderboard"
    }
  },
  "required": [
    "user_id",
    "username"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}