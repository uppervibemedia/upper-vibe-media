{
  "name": "VibeWorldPresence",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Authenticated user ID"
    },
    "username": {
      "type": "string",
      "description": "Display name shown to other users"
    },
    "avatar_type": {
      "type": "string",
      "description": "Legacy avatar type value"
    },
    "avatar_type_key": {
      "type": "string",
      "description": "Exact avatar key used in CityCanvas e.g. test-mixamo-female, test-mixamo, current"
    },
    "skin_tone": {
      "type": "string",
      "description": "Skin tone key used by procedural avatars"
    },
    "hair_style": {
      "type": "string",
      "description": "Hair style key used by procedural avatars"
    },
    "avatar_style": {
      "type": "string",
      "default": "streetwear",
      "description": "Outfit style for the avatar"
    },
    "avatar_outfit_color": {
      "type": "string",
      "description": "Outfit color key e.g. electric-blue, neon-purple"
    },
    "current_zone": {
      "type": "string",
      "description": "Current zone in Vibe World e.g. city, beach, stage, academy, dance floor"
    },
    "pos_x": {
      "type": "number",
      "default": 0,
      "description": "World X position"
    },
    "pos_y": {
      "type": "number",
      "default": 0,
      "description": "World Y position"
    },
    "pos_z": {
      "type": "number",
      "default": 0,
      "description": "World Z position"
    },
    "rotation": {
      "type": "number",
      "default": 0,
      "description": "World Y rotation in radians"
    },
    "animation_state": {
      "type": "string",
      "enum": [
        "idle",
        "walking",
        "running",
        "jumping",
        "dancing",
        "hbRiding",
        "neonSurf",
        "busy",
        "watching"
      ],
      "default": "idle",
      "description": "Current movement or activity state of the avatar"
    },
    "is_dancing": {
      "type": "boolean",
      "default": false
    },
    "is_playing_neon_surf": {
      "type": "boolean",
      "default": false
    },
    "equipped_aura": {
      "type": "string",
      "description": "Item id of equipped aura/glow, empty if none"
    },
    "equipped_aura_color": {
      "type": "string",
      "description": "Hex color of equipped aura, empty if none"
    },
    "equipped_hoverboard": {
      "type": "string",
      "description": "Item id of equipped hoverboard, empty if none"
    },
    "personal_hoverboard_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is currently riding a personal hoverboard"
    },
    "equipped_nameplate": {
      "type": "string",
      "description": "Item id of equipped nameplate, empty if none"
    },
    "equipped_badge": {
      "type": "string",
      "description": "Item id of equipped badge, empty if none"
    },
    "equipped_clothing": {
      "type": "string",
      "description": "Item id of equipped clothing, empty if none"
    },
    "vibe_level_label": {
      "type": "string",
      "description": "Optional public Vibe Level label"
    },
    "vibe_score_privacy": {
      "type": "string",
      "enum": [
        "hidden",
        "level_only",
        "exact"
      ],
      "default": "level_only"
    },
    "vibe_score_public": {
      "type": "number",
      "description": "Optional exact public score only when privacy allows it"
    },
    "is_online": {
      "type": "boolean",
      "default": true
    },
    "last_position_at": {
      "type": "string",
      "description": "ISO timestamp of last movement/appearance update"
    },
    "last_heartbeat": {
      "type": "string",
      "description": "ISO timestamp of last heartbeat"
    },
    "joined_at": {
      "type": "string",
      "description": "ISO timestamp when user entered Vibe World"
    },
    "lifetime_orbs": {
      "type": "number",
      "default": 0,
      "description": "Lifetime Vibe Orbs collected \u2014 used for leaderboard"
    }
  },
  "required": [
    "user_id",
    "username"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}