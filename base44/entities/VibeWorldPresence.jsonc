{
  "name": "VibeWorldPresence",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Authenticated user ID"
    },
    "username": {
      "type": "string",
      "description": "Display name shown to other users"
    },
    "avatar_type": {
      "type": "string",
      "description": "Avatar type key \u2014 matches uvc_test_avatar sessionStorage value",
      "default": "test-mixamo-female"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "light",
        "medium-light",
        "medium",
        "medium-dark",
        "dark",
        "deep",
        "brown",
        "tan",
        "deep-brown"
      ],
      "default": "medium"
    },
    "avatar_outfit_color": {
      "type": "string",
      "description": "Outfit color key e.g. cosmic-blue, neon-purple",
      "default": "cosmic-blue"
    },
    "avatar_style": {
      "type": "string",
      "enum": [
        "streetwear",
        "cosmic"
      ],
      "default": "streetwear",
      "description": "Outfit style for the avatar"
    },
    "current_zone": {
      "type": "string",
      "description": "Current zone in Vibe World e.g. plaza, lounge, stage"
    },
    "pos_x": {
      "type": "number",
      "default": 0,
      "description": "World X position"
    },
    "pos_z": {
      "type": "number",
      "default": 0,
      "description": "World Z position"
    },
    "rotation": {
      "type": "number",
      "default": 0,
      "description": "World Y rotation in radians"
    },
    "animation_state": {
      "type": "string",
      "enum": [
        "idle",
        "walking",
        "running",
        "dancing"
      ],
      "default": "idle",
      "description": "Current animation state of the avatar"
    },
    "is_online": {
      "type": "boolean",
      "default": true
    },
    "last_heartbeat": {
      "type": "string",
      "description": "ISO timestamp of last heartbeat"
    },
    "joined_at": {
      "type": "string",
      "description": "ISO timestamp when user entered Vibe World"
    },
    "lifetime_orbs": {
      "type": "number",
      "default": 0,
      "description": "Lifetime Vibe Orbs collected \u2014 used for leaderboard"
    }
  },
  "required": [
    "user_id",
    "username"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}