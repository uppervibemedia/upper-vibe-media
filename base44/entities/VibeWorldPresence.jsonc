{
  "name": "VibeWorldPresence",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Authenticated user ID"
    },
    "username": {
      "type": "string",
      "description": "Display name shown to other users"
    },
    "avatar_type": {
      "type": "string",
      "enum": [
        "masculine",
        "feminine",
        "nonbinary",
        "neutral",
        "default",
        "cyber",
        "cosmic",
        "neon"
      ],
      "default": "neutral"
    },
    "avatar_gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "default": "male",
      "description": "Both use Soldier.glb; female gets pink outfit tint"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "light",
        "medium-light",
        "medium",
        "medium-dark",
        "dark",
        "deep"
      ],
      "default": "medium"
    },
    "avatar_style": {
      "type": "string",
      "enum": [
        "streetwear",
        "cosmic"
      ],
      "default": "streetwear"
    },
    "current_zone": {
      "type": "string"
    },
    "pos_x": {
      "type": "number",
      "default": 0
    },
    "pos_z": {
      "type": "number",
      "default": 0
    },
    "rotation": {
      "type": "number",
      "default": 0
    },
    "animation_state": {
      "type": "string",
      "enum": [
        "idle",
        "walking",
        "running",
        "dancing"
      ],
      "default": "idle"
    },
    "is_online": {
      "type": "boolean",
      "default": true
    },
    "last_heartbeat": {
      "type": "string"
    },
    "joined_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "username"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}