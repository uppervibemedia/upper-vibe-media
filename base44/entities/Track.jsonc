{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track title"
    },
    "artist_display": {
      "type": "string",
      "description": "Display artist name \u2014 always matches primary artist name"
    },
    "primary_artist_id": {
      "type": "string",
      "description": "ID of primary artist record \u2014 source of truth for artist name"
    },
    "featured_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "album": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "frequency_hz": {
      "type": "number",
      "default": 432
    },
    "frequency_type": {
      "type": "string",
      "enum": [
        "432hz",
        "528hz",
        "standard",
        "binaural",
        "other"
      ],
      "default": "432hz"
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mood_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tier_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "supporter",
          "premium"
        ]
      },
      "default": [
        "free"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_new_release": {
      "type": "boolean",
      "default": false
    },
    "tiktok_promoted": {
      "type": "boolean",
      "default": false,
      "description": "When true, this track appears on the TikTok / link-in-bio feed page"
    },
    "tiktok_caption": {
      "type": "string",
      "description": "Caption used on the TikTok post"
    },
    "tiktok_post_type": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "quote",
        "meme"
      ],
      "default": "video",
      "description": "Type of TikTok post shown on the TikTok feed"
    },
    "tiktok_thumbnail_url": {
      "type": "string",
      "description": "TikTok video thumbnail or preview image URL"
    },
    "tiktok_post_url": {
      "type": "string",
      "description": "Original TikTok post URL"
    },
    "tiktok_view_count": {
      "type": "number",
      "default": 0
    },
    "tiktok_like_count": {
      "type": "number",
      "default": 0
    },
    "tiktok_comment_count": {
      "type": "number",
      "default": 0
    },
    "tiktok_share_count": {
      "type": "number",
      "default": 0
    },
    "tiktok_trending": {
      "type": "boolean",
      "default": false
    },
    "tiktok_pin_top": {
      "type": "boolean",
      "default": false,
      "description": "Pinned TikTok feed tracks appear before unpinned tracks"
    },
    "tiktok_display_order": {
      "type": "number",
      "default": 0,
      "description": "Lower numbers appear earlier on the TikTok feed when pinned/order is used"
    },
    "tiktok_posted_at": {
      "type": "string",
      "format": "date",
      "description": "Date this song was posted or promoted on TikTok"
    },
    "is_downloadable": {
      "type": "boolean",
      "default": true,
      "description": "All tracks are downloadable \u2014 download action is gated by premium membership"
    },
    "metadata_locked": {
      "type": "boolean",
      "default": false,
      "description": "When true, AI Organize will not overwrite this track's metadata"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "spotify_url": {
      "type": "string",
      "description": "Spotify track URL"
    },
    "apple_music_url": {
      "type": "string",
      "description": "Apple Music track URL"
    },
    "youtube_url": {
      "type": "string",
      "description": "YouTube video/music URL"
    },
    "youtube_music_url": {
      "type": "string",
      "description": "YouTube Music track URL"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}