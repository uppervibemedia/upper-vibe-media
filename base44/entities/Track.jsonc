{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track title"
    },
    "artist_display": {
      "type": "string",
      "description": "Display artist name (e.g. Jmack So Lavish feat. Aura Rae)"
    },
    "primary_artist_id": {
      "type": "string",
      "description": "ID of primary artist record"
    },
    "featured_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of featured artists"
    },
    "album": {
      "type": "string",
      "description": "Album or project name"
    },
    "description": {
      "type": "string",
      "description": "Track description"
    },
    "lyrics": {
      "type": "string",
      "description": "Full lyrics"
    },
    "cover_url": {
      "type": "string",
      "description": "Cover art image URL"
    },
    "audio_url": {
      "type": "string",
      "description": "Audio file URL"
    },
    "duration": {
      "type": "string",
      "description": "Duration e.g. 3:45"
    },
    "bpm": {
      "type": "number",
      "description": "Beats per minute"
    },
    "key": {
      "type": "string",
      "description": "Musical key"
    },
    "frequency_hz": {
      "type": "number",
      "description": "Tuning frequency e.g. 432"
    },
    "frequency_type": {
      "type": "string",
      "enum": [
        "432hz",
        "528hz",
        "standard",
        "binaural",
        "other"
      ],
      "default": "standard"
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of assigned categories (many-to-many)"
    },
    "tier_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "supporter",
          "premium"
        ]
      },
      "default": [
        "free"
      ],
      "description": "Which membership tiers can access this track"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_new_release": {
      "type": "boolean",
      "default": false
    },
    "is_downloadable": {
      "type": "boolean",
      "default": false
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Legacy compat"
    },
    "min_tier": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium"
      ],
      "default": "free",
      "description": "Legacy compat"
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "release_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}