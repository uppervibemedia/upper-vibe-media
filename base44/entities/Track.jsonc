{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track title"
    },
    "artist": {
      "type": "string",
      "description": "Artist name"
    },
    "album": {
      "type": "string",
      "description": "Album name"
    },
    "category": {
      "type": "string",
      "enum": [
        "high_vibe_hiphop",
        "reprogramming_sessions",
        "432_collection",
        "remastered",
        "exclusive_drops",
        "meditation_focus"
      ],
      "description": "Music category"
    },
    "cover_url": {
      "type": "string",
      "description": "Cover art image URL"
    },
    "audio_url": {
      "type": "string",
      "description": "Audio file URL"
    },
    "duration": {
      "type": "string",
      "description": "Track duration (e.g. 3:45)"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Whether track requires premium access (legacy, kept for compatibility)"
    },
    "min_tier": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium"
      ],
      "default": "free",
      "description": "Legacy min tier \u2014 use tier_access instead"
    },
    "tier_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "supporter",
          "premium"
        ]
      },
      "default": [
        "free"
      ],
      "description": "Which membership tiers can access this track. Premium always inherits supporter access."
    },
    "plays": {
      "type": "number",
      "default": 0,
      "description": "Number of plays"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether track is featured"
    }
  },
  "required": [
    "title",
    "artist"
  ]
}