{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track title"
    },
    "artist_display": {
      "type": "string",
      "description": "Display artist name"
    },
    "primary_artist_id": {
      "type": "string",
      "description": "ID of primary artist record"
    },
    "featured_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "album": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "frequency_hz": {
      "type": "number"
    },
    "frequency_type": {
      "type": "string",
      "enum": [
        "432hz",
        "528hz",
        "standard",
        "binaural",
        "other"
      ],
      "default": "standard"
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tier_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "supporter",
          "premium"
        ]
      },
      "default": [
        "free"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_new_release": {
      "type": "boolean",
      "default": false
    },
    "is_downloadable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this track can be downloaded"
    },
    "download_tier_required": {
      "type": "string",
      "enum": [
        "premium"
      ],
      "default": "premium",
      "description": "Always premium \u2014 kept for future flexibility"
    },
    "offline_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allow offline save"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Legacy compat"
    },
    "min_tier": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium"
      ],
      "default": "free",
      "description": "Legacy compat"
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "release_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}