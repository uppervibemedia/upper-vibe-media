{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track title"
    },
    "artist_display": {
      "type": "string",
      "description": "Display artist name"
    },
    "primary_artist_id": {
      "type": "string",
      "description": "ID of primary artist record"
    },
    "featured_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "album": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "frequency_hz": {
      "type": "number",
      "default": 432
    },
    "frequency_type": {
      "type": "string",
      "enum": [
        "432hz",
        "528hz",
        "standard",
        "binaural",
        "other"
      ],
      "default": "432hz"
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mood_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tier_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "supporter",
          "premium"
        ]
      },
      "default": [
        "free"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_new_release": {
      "type": "boolean",
      "default": false
    },
    "is_downloadable": {
      "type": "boolean",
      "default": true,
      "description": "All tracks are downloadable \u2014 download action is gated by premium membership"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "release_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}