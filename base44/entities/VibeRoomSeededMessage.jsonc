{
  "name": "VibeRoomSeededMessage",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string",
      "description": "Display name for the seeded message author"
    },
    "content": {
      "type": "string",
      "description": "The seeded message content"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this seeded message should show in the feed"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Order in which to display seeded messages"
    },
    "reactions": {
      "type": "object",
      "description": "Reaction counts keyed by type \u2014 arrays of user emails",
      "properties": {
        "felt_that": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needed_this": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inspired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gratitude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "user_name",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}