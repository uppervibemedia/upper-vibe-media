{
  "name": "VibeRoomMessage",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the message sender"
    },
    "user_name": {
      "type": "string",
      "description": "Vibe Name of the sender"
    },
    "user_avatar_url": {
      "type": "string",
      "description": "Profile picture URL of the sender at time of message"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_listening": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user had music playing when they sent the message"
    },
    "now_playing_title": {
      "type": "string",
      "description": "Track title playing at time of message (optional)"
    },
    "reactions": {
      "type": "object",
      "description": "Reaction counts keyed by type \u2014 arrays of user emails",
      "properties": {
        "felt_that": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needed_this": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inspired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gratitude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Admin soft-delete / hide message"
    },
    "report_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this message has been reported"
    },
    "reported_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who reported this message"
    }
  },
  "required": [
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}