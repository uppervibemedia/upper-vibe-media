{
  "name": "VibeRoomMessage",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the post author"
    },
    "user_name": {
      "type": "string",
      "description": "Vibe Name of the author"
    },
    "user_avatar_url": {
      "type": "string",
      "description": "Profile picture URL at time of post"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "thought",
        "track_share",
        "featured"
      ],
      "default": "thought",
      "description": "Type of feed post"
    },
    "content": {
      "type": "string",
      "description": "Listener thought text (max 280 chars)"
    },
    "track_id": {
      "type": "string",
      "description": "ID of shared track (for track_share posts)"
    },
    "track_title": {
      "type": "string",
      "description": "Cached track title"
    },
    "track_artist": {
      "type": "string",
      "description": "Cached artist name"
    },
    "track_cover_url": {
      "type": "string",
      "description": "Cached cover art URL"
    },
    "track_frequency_type": {
      "type": "string",
      "description": "e.g. 432hz, 528hz"
    },
    "is_listening": {
      "type": "boolean",
      "default": false,
      "description": "Whether user had music playing when posting"
    },
    "now_playing_title": {
      "type": "string",
      "description": "Track title playing at time of post"
    },
    "reactions": {
      "type": "object",
      "description": "Reaction counts \u2014 arrays of user emails per type",
      "properties": {
        "felt_that": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needed_this": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inspired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gratitude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Admin soft-delete"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Featured Vibe of the Day \u2014 pinned to top by admin"
    },
    "report_count": {
      "type": "number",
      "default": 0
    },
    "reported_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User emails who reported this post"
    }
  },
  "required": [
    "user_email",
    "post_type"
  ]
}