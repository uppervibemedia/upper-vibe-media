{
  "name": "VibeCheckIn",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who submitted the check-in"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "check_in_date": {
      "type": "string",
      "description": "Date of check-in in YYYY-MM-DD format"
    },
    "mood": {
      "type": "string",
      "enum": [
        "scattered",
        "low_energy",
        "neutral",
        "intentional",
        "high_vibe"
      ],
      "description": "Selected mood for the day"
    },
    "mood_score": {
      "type": "number",
      "description": "Today's answer-only Vibe Check score"
    },
    "today_score": {
      "type": "number",
      "description": "Score based only on today's Vibe Check answers"
    },
    "average_score": {
      "type": "number",
      "description": "Rolling 7-day average score, or average of available completed days"
    },
    "consistency_score": {
      "type": "number",
      "description": "Score based on check-in streak consistency"
    },
    "overall_vibe_score": {
      "type": "number",
      "description": "Overall Vibe Score: today 45%, average 35%, consistency 20%"
    },
    "intention": {
      "type": "string",
      "description": "User's daily intention"
    },
    "gratitude": {
      "type": "string",
      "description": "User's gratitude entry"
    },
    "streak_days": {
      "type": "number",
      "default": 1,
      "description": "Current streak at time of check-in"
    },
    "vibe_score": {
      "type": "number",
      "description": "Overall daily vibe score (0-100) used across mirror, progress, rewards, and leaderboards"
    },
    "category_scores": {
      "type": "object",
      "description": "Weighted Vibe Score category values: safety, clarity, consistency, gratitude, rest, action",
      "properties": {
        "safety": {
          "type": "number"
        },
        "clarity": {
          "type": "number"
        },
        "consistency": {
          "type": "number"
        },
        "gratitude": {
          "type": "number"
        },
        "rest": {
          "type": "number"
        },
        "action": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "user_id",
    "check_in_date",
    "mood"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}