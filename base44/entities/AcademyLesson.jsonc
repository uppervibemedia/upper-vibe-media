{
  "name": "AcademyLesson",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "description": {
      "type": "string",
      "description": "Video description"
    },
    "youtube_video_id": {
      "type": "string",
      "description": "YouTube video ID for deduplication"
    },
    "video_url": {
      "type": "string",
      "description": "YouTube watch URL"
    },
    "embed_url": {
      "type": "string",
      "description": "YouTube embed URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Custom labels/tags for this video e.g. 432 Hz, Manifestation, Mindset"
    },
    "category": {
      "type": "string",
      "enum": [
        "432hz_music",
        "high_vibe_music",
        "manifestation_music",
        "music_for_focus",
        "behind_the_song",
        "upper_vibe_media",
        "music_business",
        "artist_development"
      ],
      "description": "Internal category (used for import detection)"
    },
    "is_premium": {
      "type": "boolean",
      "default": true
    },
    "free_preview_seconds": {
      "type": "number",
      "default": 60
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ],
      "default": "published"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "playlist_added_date": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}