{
  "name": "EmailSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Subscriber email address"
    },
    "source_page": {
      "type": "string",
      "description": "Page where they signed up"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent string"
    },
    "referrer": {
      "type": "string",
      "description": "Referring URL"
    },
    "subscribed_status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed"
      ],
      "default": "active"
    }
  },
  "required": [
    "email"
  ]
}